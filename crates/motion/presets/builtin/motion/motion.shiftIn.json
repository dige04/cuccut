{
  "id": "motion.shiftIn",
  "version": 1,
  "domain": "motion",
  "family": null,
  "doc": "Internal building block: shifts from distance back to zero along direction.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "direction": {
      "type": "enum",
      "options": [
        "left",
        "right",
        "up",
        "down"
      ],
      "default": "up",
      "doc": "Direction the element enters/leaves from ('up' = enters from below)"
    },
    "distance": {
      "type": "length",
      "default": {
        "value": 0.045,
        "basis": "canvasShortEdge"
      },
      "doc": "Shift amount; default is 4.5% of the canvas short side"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutCubic",
      "doc": "Easing curve (closed name from spec §7.6)"
    }
  },
  "tracks": [
    {
      "prop": "x",
      "composite": "add",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": {
            "case": "{direction}",
            "of": {
              "left": {
                "length": "{distance}",
                "scale": -1
              },
              "right": {
                "length": "{distance}"
              }
            }
          }
        },
        {
          "t": "100%",
          "v": 0,
          "ease": "{curve}"
        }
      ]
    },
    {
      "prop": "y",
      "composite": "add",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": {
            "case": "{direction}",
            "of": {
              "up": {
                "length": "{distance}"
              },
              "down": {
                "length": "{distance}",
                "scale": -1
              }
            }
          }
        },
        {
          "t": "100%",
          "v": 0,
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
