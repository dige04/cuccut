{
  "id": "filter.hueRotate",
  "version": 1,
  "domain": "filter",
  "inputs": 1,
  "params": {
    "degrees": {
      "type": "number",
      "default": 0,
      "min": -360,
      "max": 360
    }
  },
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "kernel": "hue-rotate-matrix-f64",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "W3C filter-effects hue-rotate matrix (rotation around the luminance axis), angle in degrees."
}
