{
  "id": "mask.progress",
  "version": 1,
  "domain": "mask",
  "inputs": 1,
  "params": {
    "progress": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1
    },
    "invert": {
      "type": "bool",
      "default": false
    }
  },
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "kernel": "linear-reveal-coverage",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "Horizontal progress wipe, **line-for-line equivalent to `apply_horizontal_reveal` in studio_export**: boundary = progress × width, coverage = clamp(boundary - x, 0, 1). progress ∈ [0,1] (closed interval); 0 = fully transparent, 1 = unchanged."
}
