{
  "id": "zoomThrough",
  "version": 1,
  "domain": "transition",
  "namespace": "bcf",
  "order": 8,
  "prop": null,
  "ease": null,
  "doc": "The camera “passes through” the outgoing frame: the outgoing clip zooms in toward the canvas center, accelerating to 2.5× and fading out (easeInCubic), while the incoming clip decelerates from 0.5× back to 1× and fades in (easeOutCubic). The two scale channels are anchored at the canvas center and multiplied together.",
  "out": {
    "channels": [
      {
        "prop": "scale",
        "ease": "easeInCubic",
        "from": { "value": 1.0, "basis": "absolute" },
        "to": { "value": 2.5, "basis": "absolute" }
      },
      {
        "prop": "opacity",
        "ease": "easeInCubic",
        "from": { "value": 1.0, "basis": "absolute" },
        "to": { "value": 0.0, "basis": "absolute" }
      }
    ]
  },
  "in": {
    "channels": [
      {
        "prop": "scale",
        "ease": "easeOutCubic",
        "from": { "value": 0.5, "basis": "absolute" },
        "to": { "value": 1.0, "basis": "absolute" }
      },
      {
        "prop": "opacity",
        "ease": "easeOutCubic",
        "from": { "value": 0.0, "basis": "absolute" },
        "to": { "value": 1.0, "basis": "absolute" }
      }
    ]
  },
  "determinism": "strict"
}
