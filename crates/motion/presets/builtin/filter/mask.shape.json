{
  "id": "mask.shape",
  "version": 1,
  "domain": "mask",
  "inputs": 1,
  "params": {
    "shape": {
      "type": "enum",
      "default": "roundedRect",
      "options": [
        "roundedRect",
        "ellipse"
      ]
    },
    "radius": {
      "type": "length",
      "default": 0,
      "min": 0,
      "max": 0.5,
      "basis": "canvasShortEdge",
      "quantize": "none",
      "doc": "Corner radius as a fraction of the canvas short edge; clamped to half the short edge."
    },
    "radiusTopLeft": {"type":"length","default":0,"min":0,"max":0.5,"basis":"canvasShortEdge","quantize":"none"},
    "radiusTopRight": {"type":"length","default":0,"min":0,"max":0.5,"basis":"canvasShortEdge","quantize":"none"},
    "radiusBottomRight": {"type":"length","default":0,"min":0,"max":0.5,"basis":"canvasShortEdge","quantize":"none"},
    "radiusBottomLeft": {"type":"length","default":0,"min":0,"max":0.5,"basis":"canvasShortEdge","quantize":"none"},
    "feather": {
      "type": "length",
      "default": 0,
      "min": 0,
      "max": 0.25,
      "basis": "canvasShortEdge",
      "quantize": "none",
      "doc": "Feather width as a fraction of the canvas short edge."
    }
  },
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "kernel": "sdf-rounded-rect-ellipse",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "SDF coverage mask for rounded rectangles and ellipses, **line-for-line equivalent to `apply_local_clip` in studio_export**: softness = 1 + feather, coverage = (0.5 - sd)/softness + 0.5×(softness-1)/softness, and the coverage multiplies all four premultiplied channels. radius is clamped to half the short edge."
}
