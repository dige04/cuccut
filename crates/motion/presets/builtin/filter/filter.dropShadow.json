{
  "id": "filter.dropShadow",
  "version": 1,
  "domain": "filter",
  "inputs": 1,
  "params": {
    "radius": {
      "type": "length",
      "default": 0,
      "min": 0,
      "max": 0.5,
      "basis": "canvasShortEdge",
      "quantize": "round-to-int"
    },
    "dx": {
      "type": "length",
      "default": 0,
      "min": -1,
      "max": 1,
      "basis": "canvasShortEdge",
      "quantize": "round-to-int"
    },
    "dy": {
      "type": "length",
      "default": 0,
      "min": -1,
      "max": 1,
      "basis": "canvasShortEdge",
      "quantize": "round-to-int"
    },
    "color": {
      "type": "color",
      "default": [
        0,
        0,
        0,
        0.5
      ]
    }
  },
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "kernel": "shadow-blur-composite-premul",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp-shrink-window",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "Shadow layer = input tinted by color and offset → bounded box blur → placed beneath the original with premultiplied source-over. radius / dx / dy are all fractions of the canvas short edge, rounded to pixels after evaluation."
}
