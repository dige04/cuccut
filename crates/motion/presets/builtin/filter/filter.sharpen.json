{
  "id": "filter.sharpen",
  "version": 1,
  "domain": "filter",
  "inputs": 1,
  "params": {"amount": {"type": "number", "default": 0, "min": 0, "max": 1}},
  "color": {"colorSpace": "srgb-premultiplied", "precision": "u8"},
  "kernel": "sharpen-cross-premul-u8",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "Four-neighbour cross unsharp mask; amount 0 is the identity, alpha is preserved."
}
