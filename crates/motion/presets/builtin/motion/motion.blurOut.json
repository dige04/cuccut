{
  "id": "motion.blurOut",
  "version": 1,
  "domain": "motion",
  "family": "blurIn",
  "doc": "Defocus exit.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "blur": {
      "type": "number",
      "default": 8.0,
      "min": 0.0,
      "doc": "End blur radius (px)"
    },
    "curve": {
      "type": "curve",
      "default": "easeInCubic",
      "doc": "Timing curve (closed name set from spec §7.6)"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "Whether to fade in/out at the same time"
    }
  },
  "compose": [
    {
      "preset": "motion.blurTo",
      "params": {
        "blur": "{blur}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeOut",
      "when": "{fade}"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
