// The design-system runtime and its page entry are checked separately (see README “Types”): this restored copy is a complete strict type set, written with the original project's compiler options,
// without noUncheckedIndexedAccess, and vite/client is included as in the original project (the page entry imports app.css for side effects).
// The root tsconfig.json excludes these two directories; `npm run typecheck` checks both in turn.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*", "../../apps/design-system-editor/src/**/*"],
  "exclude": []
}
