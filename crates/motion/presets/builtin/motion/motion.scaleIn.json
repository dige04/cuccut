{
  "id": "motion.scaleIn",
  "version": 1,
  "domain": "motion",
  "family": "scaleIn",
  "doc": "Scale-in entrance (optional fade-in).",
  "aliases": [
    "scaleIn"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "scaleFrom": {
      "type": "number",
      "default": 0.7,
      "min": 0.0,
      "doc": "Start scale"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutCubic",
      "doc": "Easing curve (closed name from spec §7.6)"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "Whether to also fade in/out"
    }
  },
  "compose": [
    {
      "preset": "motion.zoomIn",
      "params": {
        "scaleFrom": "{scaleFrom}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeIn",
      "when": "{fade}"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
