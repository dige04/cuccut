{
  "id": "motion.seededJitter",
  "version": 1,
  "domain": "motion",
  "family": "seededJitter",
  "appliesTo": "part",
  "doc": "Per-part deterministic jitter: splitmix64 noise (spec §7.3), seed defaults to 0, composite=add.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "amplitude": {
      "type": "length",
      "default": {
        "value": 0.004,
        "basis": "canvasShortEdge"
      },
      "doc": "Jitter amplitude"
    },
    "period": {
      "type": "number",
      "default": 0.5,
      "min": 0.001,
      "doc": "Seconds per noise cycle"
    },
    "seed": {
      "type": "seed",
      "default": 0,
      "doc": "Deterministic seed (spec §7.3)"
    }
  },
  "defaults": {
    "dur": 1.0
  },
  "ops": [
    {
      "op": "noise",
      "prop": "x",
      "amplitude": "{amplitude}",
      "period": "{period}",
      "seed": "{seed}",
      "channel": 1,
      "dur": "{dur}",
      "composite": "add"
    },
    {
      "op": "noise",
      "prop": "y",
      "amplitude": "{amplitude}",
      "period": "{period}",
      "seed": "{seed}",
      "channel": 2,
      "dur": "{dur}",
      "composite": "add"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
