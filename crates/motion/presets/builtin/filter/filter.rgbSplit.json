{
  "version": 1,
  "domain": "filter",
  "inputs": 1,
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "transparent",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "id": "filter.rgbSplit",
  "kernel": "rgb-split-premul-u8",
  "params": {
    "distance": {
      "type": "length",
      "default": 0,
      "min": 0,
      "max": 0.1,
      "basis": "canvasShortEdge",
      "quantize": "round-to-int"
    },
    "angle": {
      "type": "number",
      "default": 0,
      "min": -180,
      "max": 180
    }
  },
  "doc": "Shifts the red and blue channels along angle; the green channel stays put. Alpha takes the maximum of three samples, preserving the premultiplied invariant."
}
