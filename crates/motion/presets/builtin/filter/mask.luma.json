{
  "id": "mask.luma",
  "version": 1,
  "domain": "mask",
  "inputs": 2,
  "params": {
    "invert": {
      "type": "bool",
      "default": false
    }
  },
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "kernel": "luma-mask-from-pixmap",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "The luminance of the second input (Rec.709, un-premultiplied first) is the mask (dimensions must match the input). With invert, uses 1 - luma."
}
