{
  "id": "motion.zoomIn",
  "version": 1,
  "domain": "motion",
  "family": null,
  "doc": "Internal building block: scale goes from scaleFrom back to 1.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "scaleFrom": {
      "type": "number",
      "default": 0.7,
      "min": 0.0,
      "doc": "Starting scale"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutCubic",
      "doc": "Time curve (a closed name from spec §7.6)"
    }
  },
  "tracks": [
    {
      "prop": "scale",
      "composite": "multiply",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": "{scaleFrom}"
        },
        {
          "t": "100%",
          "v": 1,
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
