{
  "id": "motion.rotateIn",
  "version": 1,
  "domain": "motion",
  "family": "rotateIn",
  "doc": "Rotate-in entrance (optional fade-in).",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "rotationFrom": {
      "type": "number",
      "default": -12.0,
      "doc": "Start angle (degrees)"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutCubic",
      "doc": "Easing curve (closed name from spec §7.6)"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "Whether to also fade in/out"
    }
  },
  "compose": [
    {
      "preset": "motion.spinIn",
      "params": {
        "rotationFrom": "{rotationFrom}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeIn",
      "when": "{fade}"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
