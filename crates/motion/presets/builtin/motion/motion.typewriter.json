{
  "id": "motion.typewriter",
  "version": 1,
  "domain": "motion",
  "family": "typewriter",
  "appliesTo": "part",
  "doc": "Per-part typewriter: each part fades in within a very short window. Pair with animate.parts stagger.gap to control typing speed.",
  "aliases": [
    "typeIn"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "curve": {
      "type": "curve",
      "default": "linear",
      "doc": "Easing curve (closed name from spec §7.6)"
    }
  },
  "defaults": {
    "dur": 0.04
  },
  "tracks": [
    {
      "prop": "opacity",
      "composite": "multiply",
      "order": 10,
      "frames": [
        {
          "t": "0%",
          "v": 0
        },
        {
          "t": "100%",
          "v": 1,
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
