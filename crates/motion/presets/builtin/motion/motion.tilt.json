{
  "id": "motion.tilt",
  "version": 1,
  "domain": "motion",
  "family": "tilt",
  "doc": "One angle nudge that returns to zero. composite=add, summed with the main motion's rotation.",
  "aliases": [
    "tiltNudge"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "angle": {
      "type": "number",
      "default": 4.0,
      "doc": "Peak angle (degrees)"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutQuad",
      "doc": "Easing curve (closed name from spec §7.6)"
    }
  },
  "tracks": [
    {
      "prop": "rotation",
      "composite": "add",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": 0
        },
        {
          "t": "50%",
          "v": "{angle}",
          "ease": "{curve}"
        },
        {
          "t": "100%",
          "v": 0,
          "ease": "easeInOutQuad"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
