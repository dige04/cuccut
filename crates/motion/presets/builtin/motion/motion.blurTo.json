{
  "id": "motion.blurTo",
  "version": 1,
  "domain": "motion",
  "family": null,
  "doc": "Internal building block: blur spreads from 0 to blur.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "blur": {
      "type": "number",
      "default": 8.0,
      "min": 0.0,
      "doc": "End blur radius (px)"
    },
    "curve": {
      "type": "curve",
      "default": "easeInCubic",
      "doc": "Timing curve (closed name set from spec §7.6)"
    }
  },
  "tracks": [
    {
      "prop": "blur",
      "composite": "add",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": 0
        },
        {
          "t": "100%",
          "v": "{blur}",
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
