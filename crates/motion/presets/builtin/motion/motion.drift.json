{
  "id": "motion.drift",
  "version": 1,
  "domain": "motion",
  "family": "drift",
  "doc": "Slow floating: sine tracks on x and y with different periods (Lissajous), composite=add. Unlike shake, it is continuously differentiable and its periods are in seconds.",
  "aliases": [
    "drift",
    "floatDrift"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "amplitude": {
      "type": "length",
      "default": {
        "value": 0.012,
        "basis": "canvasShortEdge"
      },
      "doc": "Drift amplitude; default is 1.2% of the canvas short edge."
    },
    "period": {
      "type": "number",
      "default": 3.2,
      "min": 0.001,
      "doc": "Horizontal period (seconds)"
    },
    "periodY": {
      "type": "number",
      "default": 4.1,
      "min": 0.001,
      "doc": "Vertical period (seconds); a value coprime with period makes the motion less repetitive."
    }
  },
  "ops": [
    {
      "op": "oscillate",
      "prop": "x",
      "amplitude": "{amplitude}",
      "period": "{period}",
      "phase": 0.0,
      "wave": "sine",
      "dur": "{dur}",
      "composite": "add"
    },
    {
      "op": "oscillate",
      "prop": "y",
      "amplitude": "{amplitude}",
      "period": "{periodY}",
      "phase": 0.25,
      "wave": "sine",
      "dur": "{dur}",
      "composite": "add"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
