{
  "id": "motion.spinOut",
  "version": 1,
  "domain": "motion",
  "family": null,
  "doc": "Internal building block: rotation goes from 0 to rotationTo.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "rotationTo": {
      "type": "number",
      "default": 12.0,
      "doc": "End angle (degrees)"
    },
    "curve": {
      "type": "curve",
      "default": "easeInCubic",
      "doc": "Time curve (a closed name from spec §7.6)"
    }
  },
  "tracks": [
    {
      "prop": "rotation",
      "composite": "add",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": 0
        },
        {
          "t": "100%",
          "v": "{rotationTo}",
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
