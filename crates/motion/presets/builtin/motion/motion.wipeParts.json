{
  "id": "motion.wipeParts",
  "version": 1,
  "domain": "motion",
  "family": "wipeParts",
  "appliesTo": "part",
  "doc": "Per-part sideways wipe-in (an approximation of translation plus fade-in). A true clip-style wipe needs a clipPath channel; see stage 4.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "direction": {
      "type": "enum",
      "options": [
        "left",
        "right"
      ],
      "default": "left",
      "doc": "Wipe-in direction ('left' = enters from the left side)"
    },
    "distance": {
      "type": "length",
      "default": {
        "value": 0.02,
        "basis": "canvasShortEdge"
      },
      "doc": "Starting horizontal offset"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutQuart",
      "doc": "Time curve (a closed name from spec §7.6)"
    }
  },
  "defaults": {
    "dur": 0.3
  },
  "tracks": [
    {
      "prop": "x",
      "composite": "add",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": {
            "case": "{direction}",
            "of": {
              "left": {
                "length": "{distance}",
                "scale": -1
              },
              "right": {
                "length": "{distance}",
                "scale": 1
              }
            }
          }
        },
        {
          "t": "100%",
          "v": 0,
          "ease": "{curve}"
        }
      ]
    },
    {
      "prop": "opacity",
      "composite": "multiply",
      "order": 10,
      "frames": [
        {
          "t": "0%",
          "v": 0
        },
        {
          "t": "100%",
          "v": 1,
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
