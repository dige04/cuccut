# Copy to `.cargo/config.local.toml` (not under version control) and adjust for this machine.
# Common use: move Cargo build output to an external drive so the target directory does not fill the system disk.
[build]
target-dir = "/Volumes/YourDisk/cargo-target/cuccut"

# You can also put machine-specific environment variable overrides here, for example:
# [env]
# SDKROOT = "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
