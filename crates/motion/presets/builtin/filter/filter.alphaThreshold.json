{
  "id": "filter.alphaThreshold",
  "version": 1,
  "domain": "filter",
  "inputs": 1,
  "params": {
    "threshold": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    "softness": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 1
    }
  },
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "kernel": "alpha-threshold-smoothstep",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "Binarizes by alpha threshold; when softness > 0, transitions linearly within [threshold-softness, threshold+softness]; the coverage is multiplied across all four premultiplied channels (so the invariant rgb ≤ a still holds)."
}
