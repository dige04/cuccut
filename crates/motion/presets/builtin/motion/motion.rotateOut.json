{
  "id": "motion.rotateOut",
  "version": 1,
  "domain": "motion",
  "family": "rotateIn",
  "doc": "Rotate-out exit (optional fade-out).",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "rotationTo": {
      "type": "number",
      "default": 12.0,
      "doc": "End angle (degrees)"
    },
    "curve": {
      "type": "curve",
      "default": "easeInCubic",
      "doc": "Easing curve (closed name from spec §7.6)"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "Whether to also fade in/out"
    }
  },
  "compose": [
    {
      "preset": "motion.spinOut",
      "params": {
        "rotationTo": "{rotationTo}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeOut",
      "when": "{fade}"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
