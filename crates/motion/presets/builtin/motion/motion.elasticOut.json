{
  "id": "motion.elasticOut",
  "version": 1,
  "domain": "motion",
  "family": "elasticIn",
  "doc": "Elastic exit combining shift and scale. The closed easing enum in spec Appendix A has no easeInElastic, so the default uses easeInBack.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "direction": {
      "type": "enum",
      "options": [
        "left",
        "right",
        "up",
        "down"
      ],
      "default": "up",
      "doc": "Direction the element enters/leaves from ('up' = enters from below)"
    },
    "distance": {
      "type": "length",
      "default": {
        "value": 0.03,
        "basis": "canvasShortEdge"
      },
      "doc": "Shift amount; default is 3% of the canvas short side"
    },
    "scaleTo": {
      "type": "number",
      "default": 0.7,
      "min": 0.0,
      "doc": "End scale"
    },
    "curve": {
      "type": "curve",
      "default": "easeInBack",
      "doc": "Easing curve (closed name from spec §7.6)"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "Whether to also fade in/out"
    }
  },
  "compose": [
    {
      "preset": "motion.shiftOut",
      "params": {
        "direction": "{direction}",
        "distance": "{distance}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.zoomOut",
      "params": {
        "scaleTo": "{scaleTo}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeOut",
      "when": "{fade}"
    }
  ],
  "defaults": {
    "curve": "easeInBack"
  },
  "determinism": "strict",
  "capabilities": []
}
