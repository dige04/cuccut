{
  "id": "motion.pulse",
  "version": 1,
  "domain": "motion",
  "family": "pulse",
  "doc": "Breathing-style scale-up then back down. composite=multiply, multiplies with the main motion's scale.",
  "aliases": [
    "pulse",
    "pop"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "scale": {
      "type": "number",
      "default": 1.06,
      "min": 0.0,
      "doc": "Peak scale"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutBack",
      "doc": "Timing curve (closed name set from spec §7.6)"
    }
  },
  "tracks": [
    {
      "prop": "scale",
      "composite": "multiply",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": 1
        },
        {
          "t": "55%",
          "v": "{scale}",
          "ease": "{curve}"
        },
        {
          "t": "100%",
          "v": 1,
          "ease": "easeInOutQuad"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
