{
  "id": "motion.riseParts",
  "version": 1,
  "domain": "motion",
  "family": "riseParts",
  "appliesTo": "part",
  "doc": "Per-part rise and fade-in. Same visual as timeline.enter.riseWords@1, parameterized and exposed to BCF.",
  "aliases": [
    "riseWordsParts"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "distance": {
      "type": "length",
      "default": {
        "value": 0.026,
        "basis": "canvasShortEdge"
      },
      "doc": "Start sink amount; default is 2.6% of the canvas short side"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutCubic",
      "doc": "Easing curve (closed name from spec §7.6)"
    }
  },
  "defaults": {
    "dur": 0.35
  },
  "tracks": [
    {
      "prop": "y",
      "composite": "add",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": "{distance}"
        },
        {
          "t": "100%",
          "v": 0,
          "ease": "{curve}"
        }
      ]
    },
    {
      "prop": "opacity",
      "composite": "multiply",
      "order": 10,
      "frames": [
        {
          "t": "0%",
          "v": 0
        },
        {
          "t": "100%",
          "v": 1,
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
