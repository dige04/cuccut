{
  "id": "motion.scaleOut",
  "version": 1,
  "domain": "motion",
  "family": "scaleIn",
  "doc": "Scale-out exit (optional fade-out).",
  "aliases": [
    "scaleOut"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "scaleTo": {
      "type": "number",
      "default": 0.7,
      "min": 0.0,
      "doc": "End scale"
    },
    "curve": {
      "type": "curve",
      "default": "easeInCubic",
      "doc": "Easing curve (closed name from spec §7.6)"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "Whether to also fade in/out"
    }
  },
  "compose": [
    {
      "preset": "motion.zoomOut",
      "params": {
        "scaleTo": "{scaleTo}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeOut",
      "when": "{fade}"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
