{
  "id": "motion.fadeIn",
  "version": 1,
  "domain": "motion",
  "family": "fadeIn",
  "doc": "Fade in. composite=multiply, can stack with the main motion.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "curve": {
      "type": "curve",
      "default": "easeOutCubic",
      "doc": "Timing curve (closed name set from spec §7.6)"
    }
  },
  "tracks": [
    {
      "prop": "opacity",
      "composite": "multiply",
      "order": 10,
      "frames": [
        {
          "t": "0%",
          "v": 0
        },
        {
          "t": "100%",
          "v": 1,
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
