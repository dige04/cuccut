{
  "id": "motion.rollOut",
  "version": 1,
  "domain": "motion",
  "family": "rollIn",
  "doc": "Shift + rotate roll-out.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "direction": {
      "type": "enum",
      "options": [
        "left",
        "right",
        "up",
        "down"
      ],
      "default": "up",
      "doc": "Direction the element enters/leaves from ('up' = enters from below)"
    },
    "distance": {
      "type": "length",
      "default": {
        "value": 0.045,
        "basis": "canvasShortEdge"
      },
      "doc": "Shift amount; default is 4.5% of the canvas short side"
    },
    "rotationTo": {
      "type": "number",
      "default": 24.0,
      "doc": "End angle (degrees)"
    },
    "curve": {
      "type": "curve",
      "default": "easeInCubic",
      "doc": "Easing curve (closed name from spec §7.6)"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "Whether to also fade in/out"
    }
  },
  "compose": [
    {
      "preset": "motion.shiftOut",
      "params": {
        "direction": "{direction}",
        "distance": "{distance}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.spinOut",
      "params": {
        "rotationTo": "{rotationTo}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeOut",
      "when": "{fade}"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
