{
  "id": "motion.zoomOut",
  "version": 1,
  "domain": "motion",
  "family": null,
  "doc": "Internal building block: scale goes from 1 to scaleTo.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "scaleTo": {
      "type": "number",
      "default": 0.7,
      "min": 0.0,
      "doc": "End scale"
    },
    "curve": {
      "type": "curve",
      "default": "easeInCubic",
      "doc": "Time curve (a closed name from spec §7.6)"
    }
  },
  "tracks": [
    {
      "prop": "scale",
      "composite": "multiply",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": 1
        },
        {
          "t": "100%",
          "v": "{scaleTo}",
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
