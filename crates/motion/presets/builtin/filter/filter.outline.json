{
  "version": 1,
  "domain": "filter",
  "inputs": 1,
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "transparent",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "id": "filter.outline",
  "kernel": "alpha-outline-square-premul-u8",
  "params": {
    "radius": {
      "type": "length",
      "default": 0,
      "min": 0,
      "max": 0.1,
      "basis": "canvasShortEdge",
      "quantize": "round-to-int"
    },
    "color": {
      "type": "color",
      "default": [
        1,
        1,
        1,
        1
      ]
    }
  },
  "doc": "Square-radius dilation of alpha, with the colour placed beneath the original; suited to foregrounds that already have alpha or a style.mask."
}
