{
  "id": "motion.moveOut",
  "version": 1,
  "domain": "motion",
  "family": "moveIn",
  "doc": "Exit by translating in a direction (optional fade out).",
  "aliases": [
    "slideOut"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "direction": {
      "type": "enum",
      "options": [
        "left",
        "right",
        "up",
        "down"
      ],
      "default": "up",
      "doc": "Direction the element enters or leaves from ('up' = enters from below)."
    },
    "distance": {
      "type": "length",
      "default": {
        "value": 0.045,
        "basis": "canvasShortEdge"
      },
      "doc": "Translation amount; default is 4.5% of the canvas short edge."
    },
    "curve": {
      "type": "curve",
      "default": "easeInCubic",
      "doc": "Timing curve (closed name set from spec §7.6)"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "Whether to fade in/out at the same time"
    }
  },
  "compose": [
    {
      "preset": "motion.shiftOut",
      "params": {
        "direction": "{direction}",
        "distance": "{distance}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeOut",
      "when": "{fade}"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
