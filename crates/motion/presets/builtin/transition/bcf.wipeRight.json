{
  "id": "wipeRight",
  "version": 1,
  "domain": "transition",
  "namespace": "bcf",
  "order": 7,
  "prop": null,
  "ease": "easeInOutSine",
  "doc": "The wipe edge sweeps from left to right. The edge is at x = p·W; the outgoing clip keeps the area right of the edge, and the incoming clip keeps the area left of it. Mirrors wipeLeft item by item.",
  "out": {
    "channels": [
      {
        "prop": "clipInsetLeft",
        "from": { "value": 0.0, "basis": "absolute" },
        "to": { "value": 1.0, "basis": "absolute" }
      }
    ]
  },
  "in": {
    "channels": [
      {
        "prop": "clipInsetRight",
        "from": { "value": 1.0, "basis": "absolute" },
        "to": { "value": 0.0, "basis": "absolute" }
      }
    ]
  },
  "determinism": "strict"
}
