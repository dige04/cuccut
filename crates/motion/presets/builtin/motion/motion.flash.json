{
  "id": "motion.flash",
  "version": 1,
  "domain": "motion",
  "family": "flash",
  "doc": "One opacity dip that returns to full. composite=multiply.",
  "aliases": [
    "flash"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "to": {
      "type": "number",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0,
      "doc": "Trough opacity"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutQuad",
      "doc": "Easing curve (closed name from spec §7.6)"
    }
  },
  "tracks": [
    {
      "prop": "opacity",
      "composite": "multiply",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": 1
        },
        {
          "t": "50%",
          "v": "{to}",
          "ease": "{curve}"
        },
        {
          "t": "100%",
          "v": 1,
          "ease": "easeInOutQuad"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
