{
  "id": "motion.blurIn",
  "version": 1,
  "domain": "motion",
  "family": "blurIn",
  "doc": "Blur-in entrance (the blur channel is consumed by the Filter Pass in stage 4).",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "blur": {
      "type": "number",
      "default": 8.0,
      "min": 0.0,
      "doc": "Start blur radius (px)"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutCubic",
      "doc": "Easing curve (closed name from spec §7.6)"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "Whether to also fade in/out"
    }
  },
  "compose": [
    {
      "preset": "motion.blurFrom",
      "params": {
        "blur": "{blur}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeIn",
      "when": "{fade}"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
