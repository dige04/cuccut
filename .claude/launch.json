{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "designs",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec npm run dev:designs -- --port \"${PORT:-4331}\""
      ],
      "port": 4331,
      "autoPort": true
    },
    {
      "name": "desktop-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "legacy-import-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".dev/preview-shim/start.mjs"
      ],
      "port": 5199
    },
    {
      "name": "portal",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec npm run dev -w @cuccut/portal -- --port \"${PORT:-8787}\" --ip 127.0.0.1"
      ],
      "port": 8787,
      "autoPort": true
    }
  ]
}
