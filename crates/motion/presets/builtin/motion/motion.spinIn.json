{
  "id": "motion.spinIn",
  "version": 1,
  "domain": "motion",
  "family": null,
  "doc": "Internal building block: rotates from rotationFrom back to 0.",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "rotationFrom": {
      "type": "number",
      "default": -12.0,
      "doc": "Start angle (degrees)"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutCubic",
      "doc": "Easing curve (closed name from spec §7.6)"
    }
  },
  "tracks": [
    {
      "prop": "rotation",
      "composite": "add",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": "{rotationFrom}"
        },
        {
          "t": "100%",
          "v": 0,
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
