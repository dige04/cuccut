{
  "id": "motion.backIn",
  "version": 1,
  "domain": "motion",
  "family": "backIn",
  "doc": "Entrance with translation + scale and overshoot bounce (easeOutBack).",
  "aliases": [
    "springPop"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "direction": {
      "type": "enum",
      "options": [
        "left",
        "right",
        "up",
        "down"
      ],
      "default": "up",
      "doc": "Direction the element enters or leaves from ('up' = enters from below)."
    },
    "distance": {
      "type": "length",
      "default": {
        "value": 0.03,
        "basis": "canvasShortEdge"
      },
      "doc": "Translation amount; default is 3% of the canvas short edge."
    },
    "scaleFrom": {
      "type": "number",
      "default": 0.7,
      "min": 0.0,
      "doc": "Starting scale"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutBack",
      "doc": "Timing curve (closed name set from spec §7.6)"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "Whether to fade in/out at the same time"
    }
  },
  "compose": [
    {
      "preset": "motion.shiftIn",
      "params": {
        "direction": "{direction}",
        "distance": "{distance}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.zoomIn",
      "params": {
        "scaleFrom": "{scaleFrom}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeIn",
      "when": "{fade}"
    }
  ],
  "defaults": {
    "curve": "easeOutBack"
  },
  "determinism": "strict",
  "capabilities": []
}
