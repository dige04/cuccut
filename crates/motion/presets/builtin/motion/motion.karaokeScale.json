{
  "id": "motion.karaokeScale",
  "version": 1,
  "domain": "motion",
  "family": "karaokeScale",
  "appliesTo": "part",
  "doc": "Per-part pop: scales around each part's own bounding-box center (record_text owns the anchor), composite=multiply.",
  "aliases": [
    "karaoke"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "scale": {
      "type": "number",
      "default": 1.18,
      "min": 0.0,
      "doc": "Peak scale"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutBack",
      "doc": "Easing curve (closed name from spec §7.6)"
    }
  },
  "defaults": {
    "dur": 0.28
  },
  "tracks": [
    {
      "prop": "scale",
      "composite": "multiply",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": 1
        },
        {
          "t": "45%",
          "v": "{scale}",
          "ease": "{curve}"
        },
        {
          "t": "100%",
          "v": 1,
          "ease": "easeInOutQuad"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
