{
  "id": "motion.shake",
  "version": 1,
  "domain": "motion",
  "family": "shake",
  "doc": "Shake: two splitmix64 noise tracks for x / y (spec §7.3), composite=add, can stack on the main motion. seed defaults to 0.",
  "aliases": [
    "shake"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "amplitude": {
      "type": "length",
      "default": {
        "value": 0.008,
        "basis": "canvasShortEdge"
      },
      "doc": "Shake amplitude; default is 0.8% of the canvas short side"
    },
    "period": {
      "type": "number",
      "default": 0.12,
      "min": 0.001,
      "doc": "Seconds per noise cycle; smaller is choppier"
    },
    "seed": {
      "type": "seed",
      "default": 0,
      "doc": "Deterministic seed (spec §7.3); x / y derive their own sub-seeds from the channel"
    }
  },
  "ops": [
    {
      "op": "noise",
      "prop": "x",
      "amplitude": "{amplitude}",
      "period": "{period}",
      "seed": "{seed}",
      "channel": 1,
      "dur": "{dur}",
      "composite": "add"
    },
    {
      "op": "noise",
      "prop": "y",
      "amplitude": "{amplitude}",
      "period": "{period}",
      "seed": "{seed}",
      "channel": 2,
      "dur": "{dur}",
      "composite": "add"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
